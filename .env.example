# Expo Public Environment Variables (Client-side)
EXPO_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend Secrets (Set in Convex Dashboard / CLI - NEVER in client files):
# npx convex env set ELEVENLABS_API_KEY your_elevenlabs_api_key
# npx convex env set GEMINI_API_KEY your_gemini_api_key
# npx convex env set JWT_PRIVATE_JWK "$(node scripts/generate-jwt-key.mjs)"   (auth signing key; one per deployment)
